<IfModule mod_rewrite.c>
    RewriteEngine On

    # -----------------------------------------------------------------
    # 1) Canonical domain + scheme — تحويلة 301 واحدة.
    #    www.alyasi.dev (http أو https) → https://alyasi.dev
    #    http://alyasi.dev                → https://alyasi.dev
    #    (ملاحظة: قد يسبق هذا تحويل https تلقائي من طبقة hCDN نفسها —
    #    خارج نطاق هذا الملف، غير قابل للتعديل من هنا. القاعدة هنا
    #    تبقى صحيحة وتُطبَّق دائمًا لأي طلب يصل فعليًا لهذا الملف.)
    # -----------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE,QSA]

    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE,QSA]

    # -----------------------------------------------------------------
    # القواعد 2-4 تعتمد على REQUEST_URI مقيّدة بشرط REDIRECT_STATUS
    # فاضٍ (يعني هذا أول مرور على الطلب الخارجي الأصلي، قبل إعادة
    # الكتابة الداخلية لـ public/ بقاعدة (5) بالأسفل). Apache/LiteSpeed
    # يملأ REDIRECT_STATUS تلقائيًا بعد أي إعادة كتابة داخلية ضمن نفس
    # الطلب، فهذا الشرط يمنع القواعد من مطابقة الطلب المعاد كتابته
    # داخليًا (اللي يحتوي فعليًا /public) ومنع حلقة تحويلات لا نهائية.
    # -----------------------------------------------------------------

    # 2) index.php أو public/index.php → /
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^/(?:public/)?index\.php$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}/ [L,R=301]

    # 3) امنع ظهور /public في الرابط نهائيًا — أي طلب صريح لـ /public/*
    #    يتحول 301 لنفس المسار بدونها. Document Root الحالي على
    #    Hostinger هو جذر المشروع لا public/، لذا تبقى /public قابلة
    #    للوصول فعليًا كملفات ما لم نمنعها هنا صراحة (المسار المثالي هو
    #    تعديل Document Root من إعدادات الاستضافة ليشير لـ public/
    #    مباشرة وحذف هذا الملف بالكامل — راجع ملاحظة النشر).
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^/public(/(.*))?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}/%2 [L,R=301,NE,QSA]

    # 4) رابط منتهٍ بشرطة مائلة → نفس الرابط النظيف بدونها (وليس إلى
    #    /public أبدًا). نستثني المجلدات الحقيقية الموجودة فعلاً تحت
    #    public/ (صور/ملفات مرفوعة) حتى لا نكسر تصفحها.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} !-d
    RewriteCond %{REQUEST_URI} ^/(.+)/$
    RewriteRule ^ https://%{HTTP_HOST}/%1 [L,R=301,NE,QSA]

    # -----------------------------------------------------------------
    # 5) تمرير داخلي فقط (بدون تحويل ظاهر للمتصفح) إلى نقطة الدخول
    #    الفعلية داخل public/ — لازم طالما Document Root ما زال يشير
    #    لجذر المشروع بدل public/ مباشرة على Hostinger.
    # -----------------------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
